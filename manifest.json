{
  "manifest_version": 3,
  "name": "AWS Hop",
  "version": "0.1.0",
  "description": "Switch AWS console accounts in one click: IAM users, Switch Role, IAM Identity Center and SAML, with a production guard.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "AWS Hop",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open AWS Hop"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.console.aws.amazon.com/*"],
      "js": ["src/content/nav-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.console.aws.amazon.com/*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/lib/*.js", "src/providers/*.js"],
      "matches": ["https://*.console.aws.amazon.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "somaz94",
  "homepage_url": "https://github.com/somaz94/aws-hop-google-extension"
}
